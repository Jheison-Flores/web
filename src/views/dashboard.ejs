<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Panel de Administración</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #fff0f6;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 900px;
      margin: 40px auto;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 2px 12px rgba(255,182,213,0.10);
      padding: 32px 28px;
    }
    h1, h2 {
      color: #d72660;
      margin-top: 0;
      text-align: center;
    }
    form.agregar {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 32px;
      background: #ffe0ef;
      padding: 18px 14px;
      border-radius: 10px;
      box-shadow: 0 1px 6px rgba(215,38,96,0.07);
      justify-content: center;
    }
    form.agregar input,
    form.agregar textarea {
      border: 1px solid #ffb6d5;
      border-radius: 6px;
      padding: 8px;
      font-size: 1rem;
      width: 180px;
      background: #fff;
      resize: none;
    }
    form.agregar textarea {
      width: 250px;
      height: 40px;
    }
    form.agregar button {
      background: #d72660;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 10px 22px;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
    }
    form.agregar button:hover {
      background: #a61e4d;
    }
    .logout-link {
      float: right;
      margin-bottom: 16px;
      color: #d72660;
      text-decoration: none;
      font-weight: bold;
      transition: color 0.2s;
    }
    .logout-link:hover {
      color: #a61e4d;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 24px;
      background: #ffe0ef;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 1px 6px rgba(215,38,96,0.07);
    }
    th, td {
      padding: 12px 10px;
      text-align: center;
    }
    th {
      background: #ffb6d5;
      color: #a61e4d;
      font-size: 1.1rem;
    }
    tr:nth-child(even) {
      background: #fff;
    }
    tr:hover {
      background: #ffe0ef;
    }
    .img-mini {
      width: 60px;
      border-radius: 8px;
      box-shadow: 0 1px 4px rgba(215,38,96,0.07);
    }
    
    .acciones form {
      display: inline;
    }
    @media (max-width: 700px) {
      .container { padding: 10px 2px; }
      table, th, td { font-size: 0.95rem; }
      form.agregar input, form.agregar textarea { width: 100%; }
    }
  </style>
</head>
<body>
  <div class="container">
    <a href="/admin/logout" class="logout-link">Cerrar sesión</a>
    <h1>Panel de Administración</h1>
    <h2>Agregar Producto</h2>
      <form class="agregar" action="/api/productos" method="POST" enctype="multipart/form-data">
        <input name="nombre" placeholder="Nombre" required>
        <textarea name="descripcion" placeholder="Descripción" required></textarea>
        <input name="precio_original" placeholder="Precio original" type="number" min="0" step="0.01">
        <input name="precio" placeholder="Precio con descuento" type="number" min="0" step="0.01" required>
        <input type="checkbox" name="descuento" value="1" <%= typeof producto !== 'undefined' && producto.descuento ? 'checked' : '' %>>


        <input name="talla" placeholder="Talla" required>
        <input type="file" name="imagen" accept="image/*" required>
        <button type="submit">Agregar</button>
      </form>

    <h2>Lista de Productos</h2>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Imagen</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Talla</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% productos.forEach(p => { %>
            <tr>
              <td>
                <% if (p.imagen) { %>
                  <img src="/uploads/<%= p.imagen %>" class="img-mini" alt="Imagen producto">
                <% } else { %>
                  <span>Sin imagen</span>
                <% } %>
              </td>
              <td><%= p.nombre %></td>
              <td><%= p.descripcion %></td>
              <td>S/<%= p.precio %></td>
              <td><%= p.talla %></td>
              <td class="acciones">
                <a href="/admin/editar/<%= p.id %>" class="btn btn-success">Editar</a>
                <form action="/api/productos/<%= p.id %>/delete" method="POST" onsubmit="return confirm('¿Eliminar producto?')">
                  <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

